# Keep line endings stable across machines.
* text=auto

*.rs    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf

# Generated by build.rs, but committed so a plain `cargo tauri build` always
# has bundled icons available without a prior `cargo build`.
*.png binary
*.ico binary
